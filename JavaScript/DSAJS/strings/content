


// strings in javascript are immutable 
// we can't directly modify the string 
// this is not correct way to reverse a string in javascript

let str1="hello"
let j=str1.length-1;
for (let i=0;i<str1.length;i++){
    let temp=str1.charAt(i);
    str1.charAt(i)=str1.charAt(j);
    str1.charAt(j)=temp;
    j--;
}
console.log(str1); 


str1.charAt(i)=str1.charAt(j);


